{
  "name": "motsamai-web-backend",
  "version": "1.0.0",
  "description": "Web Backend API for the Motsamai Platform",
  "main": "src/server.js",
  "scripts": {
    "build": "node -e \"console.log('No build step required for web-backend')\"",
    "start": "node src/server.js",
    "start:cluster": "NODE_ENV=production CLUSTER_MODE=true node src/server.js",
    "start:prod": "NODE_ENV=production node src/server.js",
    "local:sync-env": "powershell -ExecutionPolicy Bypass -File scripts/sync-local-env.ps1",
    "env:check": "node scripts/validate-env.js",
    "firebase:check": "node scripts/test-firebase-adc.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "seed": "sequelize-cli db:seed:all",
    "seed:undo": "sequelize-cli db:seed:undo:all",
    "seed:all": "node src/seeders/index.js",
    "seed:users": "node src/seeders/01-users.seeder.js",
    "seed:drivers": "node src/seeders/02-drivers-vehicles.seeder.js",
    "seed:rides": "node src/seeders/03-rides-payments.seeder.js",
    "db:reset": "sequelize-cli db:drop && sequelize-cli db:create && npm run migrate && npm run seed:all",
    "service:install": "powershell -ExecutionPolicy Bypass -File install-web-backend-service.ps1",
    "service:uninstall": "powershell -ExecutionPolicy Bypass -File uninstall-web-backend-service.ps1"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.11.0",
    "@sendgrid/mail": "^7.7.0",
    "@supabase/supabase-js": "^2.112.3",
    "amqplib": "^0.10.3",
    "aws-sdk": "^2.1497.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "bull": "^4.11.5",
    "compression": "^1.8.1",
    "connect-redis": "^7.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-stringify": "^6.8.3",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.17.3",
    "express-validator": "^7.3.2",
    "firebase-admin": "^11.11.1",
    "helmet": "^7.2.0",
    "hpp": "^0.2.3",
    "joi": "^17.13.1",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mustache": "^4.2.0",
    "mysql2": "^3.11.3",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.1",
    "pg": "^8.21.0",
    "pg-hstore": "^2.3.4",
    "prom-client": "^15.1.3",
    "redis": "^4.7.1",
    "sequelize": "^6.37.8",
    "socket.io": "^4.5.4",
    "stripe": "^14.8.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^4.19.3",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.55.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "faker": "^5.5.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.1.0",
    "sequelize-cli": "^6.6.2",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
