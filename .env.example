# =============================
# Motsamai Web Backend - Environment Template
# =============================

# App
NODE_ENV=production
PORT=4000
API_VERSION=v1
APP_NAME=Motsamai Web Backend
APP_BASE_URL=

# Security / Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# CORS (comma-separated)
CORS_ORIGINS=https://motsamai.web.app,https://motsamai.firebaseapp.com
SOCKET_CORS_ORIGINS=https://motsamai.web.app,https://motsamai.firebaseapp.com

# Supabase PostgreSQL connection string. Copy the URI from Supabase Connect settings.
DATABASE_URL=

# Database (PostgreSQL fallback when DATABASE_URL is not used)
DB_DIALECT=postgres
DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SYNC=false
DB_SYNC_ALTER=false

# Redis (recommended)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_URL=

# Rate Limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_UPLOAD_SIZE=5242880

# AI / Driver Verification
# Root-level AI FastAPI service URL. Keep this server-side only.
AI_SERVICE_URL=
AI_SERVICE_TIMEOUT=10000
AI_SERVICE_API_KEY=
AI_VERIFICATION_URL=
AI_VERIFICATION_TIMEOUT_MS=60000
AI_VERIFICATION_HEALTH_TIMEOUT_MS=10000
BIOMETRIC_MIN_CONFIDENCE=85
BIOMETRIC_LIVENESS_MIN_CONFIDENCE=70

# Supabase PostgreSQL and Storage
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=motsamai
SUPABASE_STORAGE_PUBLIC=true

# Firebase Admin SDK. Store only a newly rotated service account in deployment secrets.
# Never commit a real service account JSON or private key to git.
FIREBASE_USE_ADC=false
FIREBASE_PROJECT_ID=motsamai-10d22
FIREBASE_DATABASE_URL=https://motsamai-10d22-default-rtdb.firebaseio.com

# Add the JSON in Render as a Secret File named firebase-service-account.json.
# Render mounts it at /etc/secrets/firebase-service-account.json.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional alternatives to FIREBASE_SERVICE_ACCOUNT_JSON.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=/etc/secrets/firebase-service-account.json
FIREBASE_GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Optional Firestore app. Defaults to the same motsamai-10d22 project.
# If omitted, backend Firestore writes use the FIREBASE_* app above.
FIRESTORE_USE_ADC=false
FIRESTORE_USER_SYNC_ENABLED=true
FIRESTORE_PROJECT_ID=motsamai-10d22
FIRESTORE_DATABASE_URL=https://motsamai-10d22-default-rtdb.firebaseio.com
FIRESTORE_CLIENT_EMAIL=
FIRESTORE_PRIVATE_KEY=
FIRESTORE_SERVICE_ACCOUNT_PATH=
FIRESTORE_SERVICE_ACCOUNT_JSON=
FIRESTORE_GOOGLE_APPLICATION_CREDENTIALS=
FIRESTORE_GOOGLE_APPLICATION_CREDENTIALS_JSON=

DEFAULT_PHONE_FOR_OAUTH_PREFIX=+266
OAUTH_AUTO_CREATE=true

# Optional Integrations
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENDGRID_API_KEY=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Observability / Ops
LOG_LEVEL=info
LOG_FILE_PATH=logs/app.log
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=

# Service URLs (optional internal linking)
AI_SERVICE_URL=
FRONTEND_URL=https://motsamai.web.app

# Configured Firebase administrator; require a verified Firebase email login.
ADMIN_EMAIL=
ADMIN_NAME=Motsamai Super Admin
ADMIN_PHONE=

# Demo admin credentials
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# Optional password for explicit non-production sample-user seeding.
SEED_DEFAULT_PASSWORD=
